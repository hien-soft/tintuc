# ---------- Bắt buộc ----------
DATABASE_URL=postgresql://news:news@localhost:5432/news
AUTH_SECRET=                 # chuỗi ngẫu nhiên dài: ký captcha, khóa cron (x-cron-key), ...
APP_ENCRYPTION_KEY=          # 32 byte base64, mã hóa TOTP secret
# URL gốc của trang; `pnpm serve` chạy web + CMS đúng host/cổng này (VD http://127.0.0.1:5500)
SITE_URL=http://localhost:3000

# ---------- Tùy chọn ----------
SITE_NAME="Tin Tức Việt Nam"
# Ảnh lưu ở ./storage/media, phục vụ qua /media
PUBLIC_MEDIA_BASE_URL=/media
# Để trống hoặc không kết nối được => khóa biên tập / rate-limit dùng bảng KvEntry trong Postgres
REDIS_URL=redis://localhost:6379
# Để trống => email chỉ in ra log
SMTP_URL=smtp://localhost:1025
MAIL_FROM="CMS Tòa soạn <no-reply@tintucvietnam.vn>"
# Danh sách IP được vào /Admin, cách nhau dấu phẩy. Để trống = không giới hạn
CMS_ALLOWED_IPS=
# Ngưỡng cảnh báo bài chờ duyệt quá hạn (phút)
REVIEW_SLA_L1_MINUTES=120
REVIEW_SLA_L2_MINUTES=60

# Render nội bộ trang bài viết (route handler gọi /{locale}/render/...).
# Chạy 1 instance thì để trống (mặc định http://127.0.0.1:$PORT và token sinh ngẫu nhiên trong tiến trình).
# Chạy nhiều instance: đặt origin nội bộ và một token bí mật dùng chung.
INTERNAL_ORIGIN=
INTERNAL_RENDER_TOKEN=

# Link khối "Hoạt động của TTVN" trên trang chủ (chỉ nhận https://; để trống thì ẩn kênh đó)
SOCIAL_FACEBOOK_URL=
SOCIAL_YOUTUBE_URL=
SOCIAL_TIKTOK_URL=
SOCIAL_ZALO_URL=

# Tài khoản chủ hệ thống do seed tạo (toàn quyền). Để trống thì dùng pv1@demo.vn / mật khẩu demo.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=
